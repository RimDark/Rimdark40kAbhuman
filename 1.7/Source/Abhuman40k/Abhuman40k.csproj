<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Abhuman40k</RootNamespace>
    <AssemblyName>Abhuman40k</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Relative default assumes the mod sits in RimWorld\Mods; a Directory.Build.props above the repo can override it -->
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\..\..\..\workshop\content\294100\</WorkshopDir>
    <VEFDir>$(WorkshopDir)2023507013\1.7\Assemblies</VEFDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\..\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Quest\StorytellerCompProperties_NavigatorDowned.cs" />
    <Compile Remove="Quest\StorytellerComp_NavigatorDowned.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Krafs.Rimworld.Ref must match the game build in RimWorld\Version.txt; Lib.Harmony.Ref must match the Workshop Harmony 1.7 build -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" />
    <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Core40k">
      <HintPath>..\..\..\..\Rimdark40kFramework\1.7\Assemblies\Core40k.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VEF">
      <HintPath>$(VEFDir)\VEF.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
