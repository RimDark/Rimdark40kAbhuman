<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Ratling: Nimble Physique -->
    <GeneDef ParentName="BEWH_AbhumanGenesOverallParent">
        <defName>BEWH_RatlingNimblePhysique</defName>
        <label>nimble physique</label>
        <description>Carriers of this gene are short in stature and have a compact build. Their size makes them harder to spot and more difficult to hit in close combat. They are also generaly more agile than the average person. However, all this makes them more vulnerable if they are hit.</description>
        <iconPath>UI/Genes/Ratling/BEWH_NimblePhysique</iconPath>
        <biostatCpx>3</biostatCpx>
        <biostatMet>-1</biostatMet>
        <displayOrderInCategory>1</displayOrderInCategory>
        <renderNodeProperties>
            <li>
                <nodeClass>PawnRenderNode_AttachmentHead</nodeClass>
                <workerClass>Core40k.PawnRenderNodeWorker_HeadCovered</workerClass>
                <texPaths>
                    <li>Things/Pawn/Humanlike/Ratling/HeadAttachments/Ears/BEWH_RatlingEars</li>
                </texPaths>
                <colorType>Skin</colorType>
                <parentTagDef>Head</parentTagDef>
                <useSkinShader>true</useSkinShader>
                <useRottenColor>true</useRottenColor>
                <rotDrawMode>Fresh, Rotting</rotDrawMode>
                <drawData>
                    <defaultData>
                        <layer>70</layer>
                    </defaultData>
                </drawData>
            </li>
        </renderNodeProperties>
        <statFactors>
            <IncomingDamageFactor>1.15</IncomingDamageFactor>
            <MoveSpeed>1.15</MoveSpeed>
        </statFactors>
        <statOffsets>
            <HuntingStealth>0.35</HuntingStealth>
            <MeleeDodgeChance>3</MeleeDodgeChance>
            <VEF_BodySize_Offset>-0.35</VEF_BodySize_Offset>
        </statOffsets>
        <customEffectDescriptions>
            <li>Decreased Size</li>
        </customEffectDescriptions>
        <exclusionTags>
            <li>Physique</li>
            <li>Ears</li>
        </exclusionTags>
    </GeneDef>

    <!-- Ratling: Culinary Instinct -->
    <GeneDef ParentName="BEWH_AbhumanGenesOverallParent">
        <defName>BEWH_RatlingCulinaryInstinct</defName>
        <label>culinary instinct</label>
        <description>Carriers of this gene are natural-born cooks. They love to cook, and, even more so, they love to eat. That's the reason they cook rapidly, and devour their cooking just as rapidly. At the same time, their amazing sense of smell helps them spot poor quality and bad ingredients.</description>
        <iconPath>UI/Genes/Ratling/BEWH_CulinaryInstincts</iconPath>
        <biostatCpx>1</biostatCpx>
        <biostatMet>-1</biostatMet>
        <displayOrderInCategory>2</displayOrderInCategory>

        <statOffsets>
            <CookSpeed>0.15</CookSpeed>
            <FoodPoisonChance>-0.75</FoodPoisonChance>
            <EatingSpeed>0.67</EatingSpeed>
        </statOffsets>
        <aptitudes>
            <Cooking>3</Cooking>
        </aptitudes>
    </GeneDef>

    <!-- Ratling: Indolent Disposition -->
    <GeneDef ParentName="BEWH_AbhumanGenesOverallParent">
        <defName>BEWH_RatlingIndolentDisposition</defName>
        <label>indolent disposition</label>
        <description>Carriers of this gene are physiologically predisposed to laziness. They love to lounge around and sleep all day (just like you), and won't pass on the opportunity to do so. It's hard to get them to work, and they tire more quickly. Still, there is a positive aspect to this - their mental break threshold is lower than that of the average person.</description>
        <iconPath>UI/Genes/Ratling/BEWH_IndolentDisposition</iconPath>
        <biostatCpx>1</biostatCpx>
        <biostatMet>1</biostatMet>
        <displayOrderInCategory>3</displayOrderInCategory>

        <forcedTraits>
            <li>
                <def>Industriousness</def>
                <degree>-1</degree>
            </li>
        </forcedTraits>
        <statOffsets>
            <MentalBreakThreshold>-0.05</MentalBreakThreshold>
            <RestFallRateFactor>0.15</RestFallRateFactor>
        </statOffsets>
    </GeneDef>

    <!-- Ratling: Gregarious -->
    <GeneDef ParentName="BEWH_AbhumanGenesOverallParent">
        <defName>BEWH_RatlingGregarious</defName>
        <label>gregarious</label>
        <description>Carriers of this gene are naturally talkative. They love all kinds of get-togethers and socializing. The more people around them, the happier they are - and vice versa.</description>
        <iconPath>UI/Genes/Ratling/BEWH_Gregarious</iconPath>
        <biostatCpx>2</biostatCpx>
        <biostatMet>-2</biostatMet>
        <displayOrderInCategory>4</displayOrderInCategory>

        <aptitudes>
            <Social>2</Social>
        </aptitudes>
        <customEffectDescriptions>
            <li>Double mood buff from parties, weddings and concerts</li>
            <li>Mood bonus or penalty depending on amount of pawns in colony</li>
        </customEffectDescriptions>
        <modExtensions>
            <li Class="Abhuman40k.DefModExtension_Gregarious">
                <thoughtEffectsDoubled>
                    <li>AttendedParty</li>
                    <li>AttendedWedding</li>
                    <li>AttendedConcert</li>
                </thoughtEffectsDoubled>
            </li>
        </modExtensions>
    </GeneDef>

    <!-- Ratling: Keen Eyed -->
    <GeneDef ParentName="BEWH_AbhumanGenesOverallParent">
        <defName>BEWH_RatlingKeenEyed</defName>
        <label>keen eyed</label>
        <description>Carriers of this gene are natural-born snipers. They are highly skilled with long-range weapons, and their keen eyesight allows them to hit targets that an ordinary person wouldn't even attempt.</description>
        <iconPath>UI/Genes/Ratling/BEWH_Keen-eyed</iconPath>
        <biostatCpx>1</biostatCpx>
        <biostatMet>-1</biostatMet>
        <displayOrderInCategory>5</displayOrderInCategory>

        <capMods>
            <li>
                <capacity>Sight</capacity>
                <postFactor>1.15</postFactor>
            </li>
        </capMods>
        <statFactors>
            <AimingDelayFactor>0.90</AimingDelayFactor>
        </statFactors>
        <statOffsets>
            <ShootingAccuracyFactor_Long>0.35</ShootingAccuracyFactor_Long>
        </statOffsets>
        <aptitudes>
            <Shooting>4</Shooting>
        </aptitudes>
    </GeneDef>

    <!-- Ratling: Scavenger Instinct -->
    <GeneDef ParentName="BEWH_AbhumanGenesOverallParent">
        <defName>BEWH_RatlingScavengerInstinct</defName>
        <label>scavenger instinct</label>
        <description>Carriers of this gene love to pocket whatever they can get their hands on, and do it remarkably well. They exploit any resources to the fullest, regardless of their origin. Steal a person's wristwatch while shaking their hand, strip a carcass down to the bare bones or take a mechanoid apart screw by screw - it's all the same to them.</description>
        <iconPath>UI/Genes/Ratling/BEWH_ScavengerInstinct</iconPath>
        <biostatCpx>2</biostatCpx>
        <biostatMet>-1</biostatMet>
        <displayOrderInCategory>6</displayOrderInCategory>

        <statFactors>
            <ForagedNutritionPerDay>1.65</ForagedNutritionPerDay>
        </statFactors>
        <statOffsets>
            <ButcheryFleshEfficiency>0.10</ButcheryFleshEfficiency>
            <ButcheryMechanoidEfficiency>0.20</ButcheryMechanoidEfficiency>
        </statOffsets>
        <customEffectDescriptions>
            <li>Don't mind tainted apparel</li>
        </customEffectDescriptions>
    </GeneDef>

    <!-- Ratling: Fecund -->
    <GeneDef ParentName="BEWH_AbhumanGenesOverallParent">
        <defName>BEWH_RatlingFecund</defName>
        <label>fecund</label>
        <description>Carriers of this gene are extremely fertile and, at the same time, highly amorous. Given enough time and privacy, they will find a way to make more carriers of this gene.</description>
        <iconPath>UI/Genes/Ratling/BEWH_Fecund</iconPath>
        <biostatCpx>1</biostatCpx>
        <biostatMet>-1</biostatMet>
        <displayOrderInCategory>7</displayOrderInCategory>

        <lovinMTBFactor>0.4</lovinMTBFactor>
        <statOffsets>
            <Fertility>0.5</Fertility>
        </statOffsets>
        <customEffectDescriptions>
            <li>Increases the chance of lovin'.</li>
        </customEffectDescriptions>
        <exclusionTags>
            <li>Libido</li>
        </exclusionTags>
    </GeneDef>

</Defs>